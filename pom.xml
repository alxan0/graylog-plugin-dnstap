<?xml version="1.0" encoding="UTF-8"?>
<!-- Dnstap input for Graylog 7.1 — a rewrite of sega-yarkin/graylog-plugin-dnstap (MIT) for the 7.x plugin API.
     Compiled against the graylog.jar of the exact server image (see build.sh); no runtime dependencies. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.graylog.plugins.dnstap</groupId>
    <artifactId>graylog-plugin-dnstap</artifactId>
    <version>1.0.1</version>
    <packaging>jar</packaging>
    <name>graylog-plugin-dnstap</name>
    <description>Dnstap (Frame Streams over TCP) input for Graylog 7.1</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <graylog.version>7.1.10</graylog.version>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencies>
        <!-- The server itself: graylog.jar from graylog/graylog:${graylog.version}, installed by build.sh -->
        <dependency>
            <groupId>org.graylog2</groupId>
            <artifactId>graylog-server-bundle</artifactId>
            <version>${graylog.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Graylog-Plugin-Properties-Path>${project.groupId}.${project.artifactId}</Graylog-Plugin-Properties-Path>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
