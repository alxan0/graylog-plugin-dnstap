#!/usr/bin/env bash
# Create (or update) Graylog-native alerting for a dnstap stream, idempotent by title:
#   event definition "dnstap: no messages for N min"  — count() < 1 on the stream over N minutes, checked every minute
#   + an HTTP notification to --webhook (optional; otherwise the event is only stored and shown under Alerts)
#
#   create-graylog-alerts --url http://graylog:9000 --user admin --password P [--stream "BIND dnstap"] [--minutes 5]
#                         [--webhook http://alerts.example/hook]
# The webhook URL is added to Graylog's URL allowlist (System > Configurations > URL Allowlist) when the allowlist is enabled.
set -euo pipefail
URL="" AUTH=() STREAM="BIND dnstap" MINUTES=5 HOOK=""
while [ $# -gt 0 ]; do
  case $1 in
    --url) URL=$2; shift ;; --token) AUTH=(-u "$2:token"); shift ;; --user) U=$2; shift ;; --password) AUTH=(-u "${U:-admin}:$2"); shift ;;
    --stream) STREAM=$2; shift ;; --minutes) MINUTES=$2; shift ;; --webhook) HOOK=$2; shift ;;
    *) echo "unknown option $1" >&2; exit 1 ;;
  esac
  shift
done
[ -n "$URL" ] && [ ${#AUTH[@]} -gt 0 ] || { echo "usage: see the header of $0" >&2; exit 1; }
api() { # METHOD PATH [JSON]
  local out code
  out=$(curl -sS -m 30 "${AUTH[@]}" -H 'X-Requested-By: dnstap-alerts' -H 'Accept: application/json' -X "$1" \
        ${3:+-H 'Content-Type: application/json' --data "$3"} -w '\n%{http_code}' "${URL%/}$2")
  code=${out##*$'\n'}; printf '%s\n' "${out%$'\n'*}"; [[ $code == 2* ]] || { echo "HTTP $code on $1 $2" >&2; return 1; }
}
sid=$(api GET /api/streams | jq -r --arg t "$STREAM" '[.streams[] | select(.title == $t)][0].id // empty')
[ -n "$sid" ] || { echo "no stream '$STREAM'" >&2; exit 1; }

nids="[]"
if [ -n "$HOOK" ]; then
  ntitle="dnstap alerts webhook"
  nid=$(api GET "/api/events/notifications?per_page=200" | jq -r --arg t "$ntitle" '[.notifications[] | select(.title == $t)][0].id // empty')
  nbody=$(jq -n --arg t "$ntitle" --arg u "$HOOK" '{title: $t, description: "graylog-plugin-dnstap monitoring", config: {type: "http-notification-v1", url: $u}}')
  if [ -z "$nid" ]; then
    nid=$(api POST /api/events/notifications "{\"entity\": $nbody}" | jq -r '.id // empty') || nid=$(api POST /api/events/notifications "$nbody" | jq -r .id)
  fi
  nids=$(jq -n --arg n "$nid" '[{notification_id: $n}]')
  echo "notification: $nid -> $HOOK"
  # Graylog's URL allowlist is enabled by default: without an entry every notification fails ("is not allowlisted")
  wl=$(api GET /api/system/urlallowlist)
  if [ "$(jq -r '.disabled' <<<"$wl")" != true ] && ! jq -e --arg u "$HOOK" '.entries[] | select(.type == "literal" and .value == $u)' <<<"$wl" >/dev/null; then
    api PUT /api/system/urlallowlist "$(jq --arg u "$HOOK" --arg i "$(cat /proc/sys/kernel/random/uuid)" \
      '.entries += [{id: $i, type: "literal", title: "dnstap alerts webhook", value: $u}]' <<<"$wl")" >/dev/null
    echo "URL allowlist: added $HOOK"
  fi
fi

title="dnstap: no messages for $MINUTES min"
def=$(jq -n --arg t "$title" --arg s "$sid" --argjson n "$nids" --argjson w $((MINUTES * 60000)) '{
  title: $t, description: "The dnstap stream received nothing: BIND, the relay or the Dnstap input is down (graylog-plugin-dnstap monitoring)",
  priority: 3, alert: true,
  config: {type: "aggregation-v1", query: "", query_parameters: [], filters: [], streams: [$s], group_by: [],
           series: [{id: "count-", type: "count"}],
           conditions: {expression: {expr: "<", left: {expr: "number-ref", ref: "count-"}, right: {expr: "number", value: 1}}},
           search_within_ms: $w, execute_every_ms: 60000, use_cron_scheduling: false, event_limit: 10},
  field_spec: {}, key_spec: [], notification_settings: {grace_period_ms: $w, backlog_size: 0},
  notifications: $n, storage: [{type: "persist-to-streams-v1", streams: ["000000000000000000000002"]}]}')
eid=$(api GET "/api/events/definitions?per_page=200" | jq -r --arg t "$title" '[.event_definitions[] | select(.title == $t)][0].id // empty')
if [ -z "$eid" ]; then
  eid=$(api POST "/api/events/definitions?schedule=true" "{\"entity\": $def}" | jq -r '.id // empty') \
    || eid=$(api POST "/api/events/definitions?schedule=true" "$def" | jq -r .id)
  echo "created event definition '$title' ($eid)"
else
  api PUT "/api/events/definitions/$eid?schedule=true" "$(jq --arg id "$eid" '. + {id: $id}' <<<"$def")" >/dev/null 2>&1 \
    || api PUT "/api/events/definitions/$eid?schedule=true" "{\"entity\": $(jq --arg id "$eid" '. + {id: $id}' <<<"$def")}" >/dev/null
  echo "updated event definition '$title' ($eid)"
fi
